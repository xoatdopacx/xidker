modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_5Vqfd5DSoYsIXO"
WHOP_PRODUCT_ID = "prod_YKfs5mljCPo6O"
ADMIN_EMAIL = "idkwdusforwork@gmail.com"

[nix]
channel = "stable-25_05"
